  + TransactionService(transactionRepository : TransactionRepository, accountRepository : AccountRepository)
  + createTransaction(dto : TransactionDTO) : TransactionDTO
  - debit(account : Account, amount : BigDecimal) : void
  - credit(account : Account, amount : BigDecimal) : void
  - requireActive(account : Account) : void
  + getTransactionsByAccount(accountId : Long) : List<TransactionDTO>
  + getTransactionById(id : Long) : TransactionDTO
  + updateTransaction(id : Long, dto : TransactionDTO) : TransactionDTO
  + deleteTransaction(id : Long) : void
  - findOrThrow(id : Long) : Transaction
  - convertToDTO(transaction : Transaction) : TransactionDTO
}
}
package "com.pesonary.ewalletapi.controller" {
class AccountController <<controller>> {
