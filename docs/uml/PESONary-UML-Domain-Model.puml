  + getTransactionById(id : Long) : ResponseEntity<ApiResponse<TransactionDTO>>
  + updateTransaction(id : Long, updatedDto : TransactionDTO) : ResponseEntity<ApiResponse<TransactionDTO>>
  + deleteTransactionById(id : Long) : ResponseEntity<ApiResponse<Void>>
}
}
package "com.pesonary.ewalletapi.security" {
class AccountSecurity <<security>> {
  - userRepository : UserRepository
