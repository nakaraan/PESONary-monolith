package "com.pesonary.ewalletapi.repository" {
interface AccountRepository <<repository>> {
  + findByStatus(status : AccountStatus) : List<Account>
  + findByCustomerId(customerId : Long) : List<Account>
}
interface CustomerRepository <<repository>> {
  + existsByEmail(email : String) : boolean
}
interface TransactionRepository <<repository>> {
  + findByAccountIdOrderByCreatedAtDesc(accountId : Long) : List<Transaction>
}
interface UserRepository <<repository>> {
  + findByUsername(username : String) : Optional<User>
  + existsByUsername(username : String) : boolean
}
}
package "com.pesonary.ewalletapi.service" {
class AccountService <<service>> {
  - accountRepository : AccountRepository
  - customerRepository : CustomerRepository
