}
class JwtUtil <<security>> {
  - signingKey : Key
  - expirationMs : long
  + JwtUtil(secret : String, expirationMs : long)
  + generateToken(username : String) : String
  - parseClaims(token : String) : Claims
  + extractUsername(token : String) : String
  + isTokenValid(token : String, user : UserDetails) : boolean
}
class SecurityConfig <<security>> {
  - jwtAuthFilter : JwtAuthenticationFilter
  - userDetailsService : CustomUserDetailsService
  - authEntryPoint : CustomAuthenticationEntryPoint
  - accessDeniedHandler : CustomAccessDeniedHandler
